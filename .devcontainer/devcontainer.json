{
    "name": "tl-framework",
    "image": "mcr.microsoft.com/dotnet/sdk:11.0.100-resolute",
    "features": {
        "ghcr.io/devcontainers/features/node:1": { "version": "24" },
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    "postCreateCommand": "dotnet restore src/App.slnx && dotnet tool restore && npm --prefix packages/framework-ui ci",
    "forwardPorts": [],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.csharp"
            ]
        }
    }
}
