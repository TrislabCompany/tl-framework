{
  "name": "@trislabcompany/framework-ui",
  "version": "0.1.0",
  "description": "The shared React UI of tl-framework: the Trislab theme, i18n, the language switch, formatting by language, the Turnstile bot check.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/TrislabCompany/tl-framework.git",
    "directory": "packages/framework-ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "cli",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme/theme.css",
    "./fonts.css": "./dist/theme/fonts.css",
    "./tailwind.css": "./dist/theme/tailwind.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"for (const f of ['theme','fonts','tailwind']) require('fs').copyFileSync('src/theme/'+f+'.css', 'dist/theme/'+f+'.css')\"",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && vitest run && npm run build && node cli/check-colors.mjs src",
    "test:screenshots": "node scripts/update-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  },
  "peerDependencies": {
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "react": "^19.3.1",
    "react-i18next": "^17.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "axe-core": "^4.14.1",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.1",
    "vitest-browser-react": "^2.3.0"
  },
  "bin": {
    "framework-ui-check-colors": "./cli/check-colors.mjs"
  }
}
