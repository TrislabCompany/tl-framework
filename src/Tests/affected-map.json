{
  "$comment": "Read by scripts/affected-tests.ps1, kept complete by Architecture.Tests/AffectedMapTests.cs. 'all': paths whose change runs every test. 'ignore': paths no test in ci / ci covers (their own workflows check them). 'areas': for each project under src/BuildingBlocks and src/Modules, the folders of src/Tests/Integration.Tests/Tests it needs; a project reached through a reference adds its own areas too. A path that matches nothing here and is not in a project runs everything.",
  "all": [
    "global.json",
    "NuGet.config",
    "nuget.config",
    "src/App.slnx",
    "src/Directory.Build.props",
    "src/Directory.Build.targets",
    "src/Directory.Packages.props",
    "src/.editorconfig",
    "src/Tests/affected-map.json",
    "src/Tests/TestHost/**",
    "src/Tests/Integration.Tests/Infrastructure/**",
    "src/Tests/Integration.Tests/*",
    "src/BuildingBlocks/Core/**",
    "src/BuildingBlocks/Shared/**",
    "src/BuildingBlocks/Web/**",
    "src/BuildingBlocks/Persistence/**",
    "src/BuildingBlocks/Tenancy/**",
    "src/BuildingBlocks/Jobs/**",
    "scripts/affected-tests.ps1",
    ".github/workflows/ci.yml"
  ],
  "ignore": [
    "**/*.md",
    "docs/**",
    ".claude/**",
    ".agents/**",
    "LICENSE",
    ".markdownlint-cli2.jsonc",
    "tests/perf/**",
    "tests/security/**",
    ".github/workflows/perf-smoke.yml",
    ".github/workflows/perf-nightly.yml",
    ".github/workflows/security-scan.yml",
    ".github/workflows/packages.yml",
    ".github/pull_request_template.md",
    ".github/CODEOWNERS",
    "scripts/check-zap-report.ps1",
    "scripts/test-host.ps1",
    "scripts/port-upstream.ps1",
    "scripts/rename-from-fsh.ps1",
    "renovate.json",
    "renovate/**"
  ],
  "areas": {
    "Caching": ["Caching"],
    "Eventing.Abstractions": ["Eventing", "Webhooks", "Notifications"],
    "Eventing": ["Eventing", "Webhooks", "Notifications"],
    "Mailing": ["Authentication", "Users"],
    "Quota": ["Billing"],
    "Storage": ["Files"],
    "Modules.Auditing.Contracts": ["Auditing", "Authorization", "Security", "Health"],
    "Modules.Auditing": ["Auditing", "Authorization", "Security", "Health"],
    "Modules.Files.Contracts": ["Files", "Security", "Health"],
    "Modules.Files": ["Files", "Security", "Health"],
    "Modules.Identity.Contracts": ["Authentication", "Authorization", "Users", "Roles", "Groups", "Sessions", "Impersonation", "Security", "Health", "Idempotency"],
    "Modules.Identity": ["Authentication", "Authorization", "Users", "Roles", "Groups", "Sessions", "Impersonation", "Security", "Health", "Idempotency"],
    "Modules.InvoiceDocuments.Contracts": ["InvoiceDocuments", "Billing", "Security", "Health"],
    "Modules.InvoiceDocuments": ["InvoiceDocuments", "Billing", "Security", "Health"],
    "Modules.InvoiceDocuments.Si": ["InvoiceDocuments"],
    "Modules.Multitenancy.Contracts": ["Multitenancy", "Tenancy", "Authentication", "Impersonation", "Security", "Health"],
    "Modules.Multitenancy": ["Multitenancy", "Tenancy", "Authentication", "Impersonation", "Security", "Health"],
    "Modules.Notifications.Contracts": ["Notifications", "Realtime", "Security", "Health"],
    "Modules.Notifications": ["Notifications", "Realtime", "Security", "Health"],
    "Modules.SubscriptionsUsage.Contracts": ["Billing", "Security", "Health"],
    "Modules.SubscriptionsUsage": ["Billing", "Security", "Health"],
    "Modules.Webhooks.Contracts": ["Webhooks", "Security", "Health"],
    "Modules.Webhooks": ["Webhooks", "Security", "Health"]
  }
