<Project>
	<PropertyGroup>
		<!-- Target framework -->
		<TargetFramework>net10.0</TargetFramework>

		<!-- Enable latest C# features and diagnostics -->
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Code quality & analysis. Warnings are errors, locally and in ci / ci alike. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>

		<!-- Docs -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591;MSG0005;CA1054;CA1056</NoWarn>
		<!-- AV0029/AV0030 (Asp.Versioning 10.2+): advisories toward AddApiVersioning().AddOpenApi(). FSH deliberately registers one
		     AddOpenApi(groupName) document per version (Web/OpenApi/Extensions.cs); also fires inside the OpenApi source-generated file. -->
		<NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
		<!-- Suppress warning about missing XML docs -->

		<!-- Prevent MSBuild from excluding common folders (optional) -->
		<NoDefaultExcludes>true</NoDefaultExcludes>
	</PropertyGroup>

	<ItemGroup>
		<!-- Sonar Analyzer for deep static analysis -->
		<PackageReference Include="SonarAnalyzer.CSharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<PropertyGroup>
		<!-- The framework's one lockstep version, shown by GET /api/health/info. A release passes the
		     tag's version (-p:Version=X.Y.Z); this is the version of an untagged build. -->
		<Version>0.1.0</Version>
		<!-- Only src/BuildingBlocks and src/Modules are packed (their own Directory.Build.props);
		     the hosts, the samples and the tests never are. See docs/packages.md. -->
		<IsPackable>false</IsPackable>

		<!-- Package metadata, the same for every package. -->
		<Authors>Trislab</Authors>
		<Company>Trislab</Company>
		<Copyright>Copyright (c) 2021-2026 fullstackhero; Trislab</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/TrislabCompany/tl-framework</PackageProjectUrl>
		<RepositoryUrl>https://github.com/TrislabCompany/tl-framework</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Description>Part of tl-framework, the framework of the Trislab SaaS products and webapps.</Description>
		<PackageTags>trislab;tl-framework</PackageTags>
	</PropertyGroup>
</Project>
