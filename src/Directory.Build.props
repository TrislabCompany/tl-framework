<Project>
	<PropertyGroup>
		<!-- Target framework -->
		<TargetFramework>net11.0</TargetFramework>

		<!-- Enable latest C# features and diagnostics -->
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Code quality & analysis. Warnings are errors, locally and in ci / ci alike. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>

		<!-- NuGet audit: every package, direct and transitive, against the advisories of every severity. A finding stays a
		     warning (NU1901 to NU1904), so a new advisory never fails an unrelated build; ci / ci shows it, and the advisory
		     is fixed in its own PR (docs/packages.md, section 5). -->
		<NuGetAudit>true</NuGetAudit>
		<NuGetAuditMode>all</NuGetAuditMode>
		<NuGetAuditLevel>low</NuGetAuditLevel>
		<WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

		<!-- Docs -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591;MSG0005;CA1054;CA1056</NoWarn>
		<!-- AV0029/AV0030 (Asp.Versioning 10.2+): advisories toward AddApiVersioning().AddOpenApi(). Trislab deliberately registers one
		     AddOpenApi(groupName) document per version (Web/OpenApi/Extensions.cs); also fires inside the OpenApi source-generated file. -->
		<NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
		<!-- Suppress warning about missing XML docs -->

		<!-- Prevent MSBuild from excluding common folders (optional) -->
		<NoDefaultExcludes>true</NoDefaultExcludes>

		<!-- Finbuckle.MultiTenant 11 and later: Trislab accepted the Open Source Maintenance Fee EULA
		     (tl-product-ideas D-41). Without it the build warns FBMT0001, which fails it. -->
		<AcceptFinbuckleEULA>true</AcceptFinbuckleEULA>
	</PropertyGroup>

	<ItemGroup>
		<!-- Sonar Analyzer for deep static analysis -->
		<PackageReference Include="SonarAnalyzer.CSharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<PropertyGroup>
		<!-- The framework's one lockstep version, shown by GET /api/health/info. A release passes the
		     tag's version (-p:Version=X.Y.Z); this is the version of an untagged build. -->
		<Version>0.1.0</Version>
		<!-- Only src/BuildingBlocks and src/Modules are packed (their own Directory.Build.props);
		     the hosts, the samples and the tests never are. See docs/packages.md. -->
		<IsPackable>false</IsPackable>

		<!-- Package metadata, the same for every package. -->
		<Authors>Trislab d.o.o.</Authors>
		<Company>Trislab d.o.o.</Company>
		<Copyright>Copyright (c) 2026 Trislab d.o.o. All rights reserved.</Copyright>
		<!-- Proprietary (LICENSE); THIRD-PARTY-NOTICES.md keeps the notices of the open-source code it derives from. -->
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageProjectUrl>https://github.com/TrislabCompany/tl-framework</PackageProjectUrl>
		<RepositoryUrl>https://github.com/TrislabCompany/tl-framework</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Description>Part of tl-framework, the framework of the Trislab SaaS products and webapps.</Description>
		<PackageTags>trislab;tl-framework</PackageTags>
	</PropertyGroup>

	<ItemGroup Condition="'$(IsPackable)' == 'true'">
		<None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
