<Project Sdk="Microsoft.NET.Sdk">

	<!-- The Slovenian country rule pack of InvoiceDocuments. It is its own package, released with the framework's one
	     version, so a product that serves no Slovenian tenant does not install it. See docs/modules.md section 6. -->
	<PropertyGroup>
		<RootNamespace>Trislab.Modules.InvoiceDocuments.Si</RootNamespace>
		<AssemblyName>Trislab.Modules.InvoiceDocuments.Si</AssemblyName>
		<Description>The Slovenian country rule pack of the Trislab InvoiceDocuments module: VAT, required content, numbering and retention.</Description>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="InvoiceDocumentsSi.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Modules.InvoiceDocuments.Contracts\Modules.InvoiceDocuments.Contracts.csproj" />
	</ItemGroup>

</Project>
