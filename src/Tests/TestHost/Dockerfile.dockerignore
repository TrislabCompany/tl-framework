# The ignore list of the test host's Dockerfile: keeps the build context small and free of local files,
# and leaves out every test project but the test host.
.git
.github
.vscode
.idea
.vs
.agents
.devcontainer
docs
src/Tests/*
!src/Tests/TestHost
**/bin
**/obj
**/TestResults
**/node_modules
*.log
.env
.env.*
.DS_Store
**/Dockerfile
.dockerignore
*.md
